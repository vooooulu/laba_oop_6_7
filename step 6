        type_layout.addWidget(self.type_label)
        type_layout.addWidget(self.type_value)

        layout.addWidget(type_widget)

        # Панель для дополнительной информации
        self.extra_label = QLabel("")
        self.extra_label.setStyleSheet("color: #88aaff;")
        layout.addWidget(self.extra_label)

        layout.addStretch()

        self.setLayout(layout)
        self.setStyleSheet("""
            QWidget {
                background-color: #3a3a3a;
                border: 1px solid #4a4a4a;
                border-radius: 5px;
            }
            QLabel {
                color: #cccccc;
            }
        """)

    def set_container(self, container):
        self.container = container
        container.changed.connect(self.update_properties)

    def update_properties(self):
        if not self.container:
            return

        selected = self.container.get_selected()

        if not selected:
            self.info_label.setText("Выберите объект")
            self.type_value.setText("Неизвестно")
            self.x_value.setText("0")
            self.y_value.setText("0")
            self.width_value.setText("0")
            self.height_value.setText("0")
            self.extra_label.setText("")
            return

        if len(selected) == 1:
            obj = selected[0]
            self.info_label.setText("Выбран 1 объект")
            self.type_value.setText(obj.get_type_name().capitalize())

            bounds = obj.get_bounds()
            self.x_value.setText(str(bounds.x()))
            self.y_value.setText(str(bounds.y()))
            self.width_value.setText(str(bounds.width()))
            self.height_value.setText(str(bounds.height()))

            # Дополнительная информация для групп
            if isinstance(obj, Group):
                self.extra_label.setText(f"Объектов в группе: {len(obj.children)}")
                self.type_value.setText(f"Группа ({len(obj.children)} объектов)")
            elif isinstance(obj, Arrow):
                self.extra_label.setText("Стрелка (связывает объекты)")
            else:
                self.extra_label.setText("")
        else:
            self.info_label.setText(f"Выбрано {len(selected)} объектов")
            self.type_value.setText("Несколько объектов")

            # Подсчитываем статистику
            groups = [obj for obj in selected if isinstance(obj, Group)]
            shapes = [obj for obj in selected if not isinstance(obj, Group) and not isinstance(obj, Arrow)]
            arrows = [obj for obj in selected if isinstance(obj, Arrow)]

            stats = []
            if shapes:
                stats.append(f"Фигуры: {len(shapes)}")
            if groups:
                total_children = sum(len(group.children) for group in groups)
                stats.append(f"Группы: {len(groups)} ({total_children} объектов)")
            if arrows:
                stats.append(f"Стрелки: {len(arrows)}")

            self.extra_label.setText(" | ".join(stats))
            self.x_value.setText("N/A")
            self.y_value.setText("N/A")
            self.width_value.setText("N/A")
            self.height_value.setText("N/A")


# ==================== Стильное рабочее пространство ====================

class CanvasWidget(QWidget):
    def __init__(self):
        super().__init__()
        self.container = GraphicContainer()
        self.factory = GraphicObjectFactory()
        self.current_tool = "rectangle"
        self.creating_arrow = False
        self.arrow_source = None
        self.drag_start = None
        self.dragging = False
        self.drag_object = None
        self.resize_handle = None

        self.setFocusPolicy(Qt.StrongFocus)
        self.setMinimumSize(800, 600)

        self.setStyleSheet("""
            QWidget {
                background-color: #2b2b2b;
                border: 2px solid #3c3c3c;
                border-radius: 5px;
            }
        """)

        self.container.changed.connect(self.update)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        gradient = QLinearGradient(0, 0, self.width(), self.height())
        gradient.setColorAt(0, QColor(45, 45, 60))
        gradient.setColorAt(1, QColor(30, 30, 40))
        painter.fillRect(self.rect(), gradient)

        painter.setPen(QPen(QColor(60, 60, 80, 80), 1))
        grid_size = 20
        for x in range(0, self.width(), grid_size):
            painter.drawLine(x, 0, x, self.height())
        for y in range(0, self.height(), grid_size):
            painter.drawLine(0, y, self.width(), y)

        painter.setPen(QPen(QColor(80, 80, 100, 120), 1))
        main_grid = 100
        for x in range(0, self.width(), main_grid):
            painter.drawLine(x, 0, x, self.height())
        for y in range(0, self.height(), main_grid):
            painter.drawLine(0, y, self.width(), y)

        painter.setPen(QPen(QColor(100, 150, 255, 150), 2))
        center_x = self.width() // 2
        center_y = self.height() // 2
        painter.drawLine(center_x, 0, center_x, self.height())
        painter.drawLine(0, center_y, self.width(), center_y)

        painter.setPen(QPen(QColor(100, 150, 255, 100), 3))
        painter.setBrush(Qt.NoBrush)
        painter.drawRect(5, 5, self.width() - 10, self.height() - 10)

        for obj in self.container.get_all():
            obj.draw(painter)

        if self.creating_arrow and self.arrow_source:
            painter.setPen(QPen(QColor(255, 100, 100), 2, Qt.DashLine))
            src_center = self.arrow_source.get_bounds().center()
            painter.drawLine(src_center, self.mapFromGlobal(QCursor.pos()))

    def mousePressEvent(self, event: QMouseEvent):
        if event.button() == Qt.LeftButton:
            pos = event.pos()
            self.drag_start = pos

            if self.creating_arrow:
                clicked_object = self._find_object_at(pos)
                if clicked_object and not isinstance(clicked_object, Arrow):
                    if self.arrow_source is None:
                        self.arrow_source = clicked_object
                        self.container.select(clicked_object)
                    else:
                        if clicked_object != self.arrow_source:
                            arrow = Arrow(self.arrow_source, clicked_object)
                            if hasattr(self.arrow_source, 'add_moved_callback'):
                                self.arrow_source.add_moved_callback(arrow.on_source_moved)
                            self.container.add(arrow)
                        self.container.deselect(self.arrow_source)
                        self.arrow_source = None
                    self.update()
                    return

            clicked_object = self._find_object_at(pos)

            if clicked_object:
                self.dragging = True
                self.drag_object = clicked_object

                ctrl_pressed = event.modifiers() & Qt.ControlModifier

                if not ctrl_pressed:
                    self.container.clear_selection()

                self.container.select(clicked_object)

                if clicked_object.selected:
                    self.resize_handle = self._get_resize_handle(clicked_object, pos)
            else:
                if self.current_tool and not self.creating_arrow:
                    # Создаем объект точно в месте клика (центрируем его)
                    new_obj = self.factory.create_object(
                        self.current_tool,
                        pos.x(),  # Убрано смещение -25
                        pos.y()  # Убрано смещение -25
                    )
                    self.container.add(new_obj)
                    self.container.clear_selection()
                    self.container.select(new_obj)
                else:
                    self.container.clear_selection()

            self.setFocus()

    def mouseMoveEvent(self, event: QMouseEvent):
        if self.dragging and self.drag_start and self.drag_object:
            pos = event.pos()
            dx = pos.x() - self.drag_start.x()
            dy = pos.y() - self.drag_start.y()

            if self.resize_handle:
                selected = self.container.get_selected()
                for obj in selected:
                    if hasattr(obj, 'resize'):
                        if self.resize_handle == 'top-left':
                            obj.move(dx, dy, self.rect())
                            obj.resize(-dx, -dy, self.rect())
                        elif self.resize_handle == 'top-right':
                            obj.move(0, dy, self.rect())
                            obj.resize(dx, -dy, self.rect())
                        elif self.resize_handle == 'bottom-left':
                            obj.move(dx, 0, self.rect())
                            obj.resize(-dx, dy, self.rect())
                        elif self.resize_handle == 'bottom-right':
                            obj.resize(dx, dy, self.rect())
            else:
                selected = self.container.get_selected()
                for obj in selected:
                    if hasattr(obj, 'move'):
                        obj.move(dx, dy, self.rect())

            self.drag_start = pos
            self.update()

    def mouseReleaseEvent(self, event: QMouseEvent):
        self.dragging = False
        self.drag_start = None
        self.drag_object = None
        self.resize_handle = None

    def _find_object_at(self, pos):
        for obj in reversed(self.container.get_all()):
            if obj.contains_point(pos):
                return obj
        return None

    def _get_resize_handle(self, obj, pos):
        bounds = obj.get_bounds()
        handles = {
            'top-left': QRect(bounds.x() - 5, bounds.y() - 5, 10, 10),
            'top-right': QRect(bounds.x() + bounds.width() - 5, bounds.y() - 5, 10, 10),
            'bottom-left': QRect(bounds.x() - 5, bounds.y() + bounds.height() - 5, 10, 10),
            'bottom-right': QRect(bounds.x() + bounds.width() - 5, bounds.y() + bounds.height() - 5, 10, 10)
        }

        for handle_name, handle_rect in handles.items():
            if handle_rect.contains(pos):
                return handle_name
        return None

    def keyPressEvent(self, event: QKeyEvent):
        selected = self.container.get_selected()
        if not selected:
            return

        workspace = self.rect()

        step = 10 if event.modifiers() & Qt.ShiftModifier else 5
        if event.key() == Qt.Key_Left:
            for obj in selected:
                if hasattr(obj, 'move'):
                    obj.move(-step, 0, workspace)
        elif event.key() == Qt.Key_Right:
            for obj in selected:
                if hasattr(obj, 'move'):
                    obj.move(step, 0, workspace)
        elif event.key() == Qt.Key_Up:
            for obj in selected:
                if hasattr(obj, 'move'):
                    obj.move(0, -step, workspace)
        elif event.key() == Qt.Key_Down:
            for obj in selected:
                if hasattr(obj, 'move'):
                    obj.move(0, step, workspace)

        elif event.key() == Qt.Key_G and event.modifiers() & Qt.ControlModifier:
            self.group_selected()
        elif event.key() == Qt.Key_U and event.modifiers() & Qt.ControlModifier:
            self.ungroup_selected()

        elif event.key() == Qt.Key_Delete:
            for obj in selected:
                self.container.remove(obj)

        # МАСШТАБИРОВАНИЕ С ПОМОЩЬЮ + И -
        elif event.key() == Qt.Key_Plus or event.key() == Qt.Key_Equal:
            scale_factor = 1.1  # Увеличение на 10%
            self.container.scale_selected(scale_factor)
            self.show_message(f"Увеличение: {scale_factor:.1f}x")

        elif event.key() == Qt.Key_Minus:
            scale_factor = 0.9  # Уменьшение на 10%
            self.container.scale_selected(scale_factor)
            self.show_message(f"Уменьшение: {scale_factor:.1f}x")

        self.update()

    def set_tool(self, tool):
        self.current_tool = tool
        self.creating_arrow = (tool == "arrow")
        self.arrow_source = None
        if self.creating_arrow:
            self.setCursor(Qt.CrossCursor)
            self.show_message("Режим создания стрелки: кликните на источник, затем на цель")
        else:
            self.setCursor(Qt.ArrowCursor)
            self.show_message(f"Инструмент: {tool}")

    def group_selected(self):
        selected = self.container.get_selected()

        valid_objects = []
        for obj in selected:
            if not isinstance(obj, Arrow) and not isinstance(obj, Group):
                valid_objects.append(obj)

        if len(valid_objects) < 2:
            QMessageBox.information(self, "Информация",
                                    "Для группировки выберите 2 или более отдельных фигур")
            return

        group = self.container.group_selected()
        if group:
            self.show_message(f"Создана группа из {len(group.children)} объектов")
        else:
            QMessageBox.warning(self, "Ошибка", "Не удалось создать группу")

    def ungroup_selected(self):
        selected = self.container.get_selected()
        groups = [obj for obj in selected if isinstance(obj, Group)]

        if not groups:
            QMessageBox.information(self, "Информация", "Выберите группу для разгруппировки")
            return

        self.container.ungroup_selected()
        self.show_message(f"Разгруппировано {len(groups)} групп")

    def save_project(self):
        filename, _ = QFileDialog.getSaveFileName(
            self, "Сохранить проект", "", "JSON файлы (*.json);;Все файлы (*)"
        )
        if filename:
            if not filename.endswith('.json'):
                filename += '.json'

            if self.container.save_to_file(filename):
                QMessageBox.information(self, "Успех",
                                        f"Проект сохранен в файл:\n{filename}")
            else:
                QMessageBox.critical(self, "Ошибка", "Не удалось сохранить проект")

    def load_project(self):
        filename, _ = QFileDialog.getOpenFileName(
            self, "Загрузить проект", "", "JSON файлы (*.json);;Все файлы (*)"
        )
        if filename:
            if self.container.load_from_file(filename):
                self.update()
                QMessageBox.information(self, "Успех",
                                        f"Проект загружен из файла:\n{filename}")
            else:
                QMessageBox.critical(self, "Ошибка", "Не удалось загрузить проект")

    def show_message(self, message: str):
        if self.parent() and hasattr(self.parent(), 'statusBar'):
            self.parent().statusBar().showMessage(message, 3000)

    def change_selected_color(self):
        selected = self.container.get_selected()
        if selected:
            color = QColorDialog.getColor()
            if color.isValid():
                for obj in selected:
                    obj.set_color(color)
                self.container.notify()
                self.show_message(f"Изменен цвет {len(selected)} объектов")
